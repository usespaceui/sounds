{
  "name": "@usespaceui/sounds",
  "version": "0.1.0",
  "description": "Procedural Web Audio UI sound engine with Apple device output mastering, 3D HRTF spatial panner, and brand voice seeding",
  "keywords": [
    "react",
    "sounds",
    "audio",
    "webaudio",
    "procedural",
    "spaceui",
    "spatial",
    "3d",
    "hrtf"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usespaceui/sounds.git"
  },
  "homepage": "https://sounds.spaceui.one",
  "bugs": {
    "url": "https://github.com/usespaceui/sounds/issues"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "license": "MIT"
}
